@using Insurancesys.web.Helper
@model Insurancesys.web.Models.LeadViewModel
@section Styles {    
    <link href="~/css/common.css" rel="stylesheet" type="text/css" />
}
@{
    Layout = "_Layout";
    if (!Model.IsEditMode)
        ViewData["Title"] = "New Lead";
    else
        ViewData["Title"] = "Edit Lead";
}

<!--begin::Subheader-->
<div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <!--begin::Info-->
        <div class="d-flex align-items-center flex-wrap mr-1">
            <!--begin::Page Heading-->
            <div class="d-flex align-items-baseline mr-5">
                <!--begin::Page Title-->
                <h5 class="text-dark font-weight-bold my-2 mr-5">@ViewData["Title"]</h5>
                <!--end::Page Title-->
                <!--begin::Breadcrumb-->
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item">
                        <a href="" class="text-muted">Sales</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="" class="text-muted">My Lead</a>
                    </li>
                </ul>
                <!--end::Breadcrumb-->
            </div>
            <!--end::Page Heading-->
        </div>
        <!--end::Info-->
    </div>
</div>
<!--end::Subheader-->
<div class="container-fluid">
    <form id="frmLead" class="form fv-plugins-bootstrap fv-plugins-framework" asp-action="SaveLead" asp-controller="Lead" method="post">
        <div class="row">
            <div class="col-md-12">
                <!--begin::Card-->
                <div class="card card-custom card-sticky" id="kt_page_sticky_card">
                    @Html.HiddenFor(x => x.IsEditMode)
                    <div class="card-header">
                        <div class="card-title">                            
                        </div>
                        <div class="card-toolbar">
                            <a asp-controller="Lead" asp-action="ListOfLeads" class="btn btn-light-primary font-weight-bolder mr-2">
                                <i class="ki ki-long-arrow-back icon-sm"></i>Back
                            </a>
                            <button type="submit" form="frmLead" name="saveAndExit" value="false" class="btn btn-primary font-weight-bolder mr-2">
                                <i class="flaticon-interface-5"></i>
                                <span class="nav-text">@(!Model.IsEditMode ? "Save & Add New" : "Update & continue")</span>
                            </button>
                            <button type="submit" form="frmLead" name="saveAndExit" value="true" class="btn btn-warning font-weight-bolder mr-2">
                                <i class="flaticon-logout"></i>
                                <span class="nav-text">@(!Model.IsEditMode ? "Save & Exit" : "Update & Exit")</span>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row justify-content-center align-items-center">
                            <!--begin::Form-->
                            <div class="col-md-12">
                                <div class="accordion accordion-solid accordion-toggle-arrow" id="accordionExample6">
                                    <div class="card" style="display: block;">
                                        <div class="card-header card-head" id="headingOne6">
                                            <div class="card-title" data-toggle="collapse" data-target="#collapseOne6" aria-expanded="false">
                                                <i class="flaticon2-layers-1"></i>
                                                Basic Information
                                            </div>
                                        </div>
                                        <div id="collapseOne6" class="collapse show" data-parent="#accordionExample6" style="align-self:center">
                                            <div class="card-body">                                                
                                                @Html.AccordianBaseTextBox("First Name", nameof(Model.FirstName), true, "Enter first name", 20)
                                                @Html.AccordianBaseTextBox("Last Name", nameof(Model.LastName), false, "Enter last name", 20)
                                                @Html.AccordianBaseTextBox("Phone Number", nameof(Model.PhoneNumber), true, "Enter phone number", 20)
                                                @Html.AccordianBaseTextBox("Email", nameof(Model.Email), false, "Enter email", 100, isRegExpression: true)
                                                @Html.AccordianBaseDropdown("Type of insurance", nameof(Model.PolicyTypeID), Model.lstInsuranceType, isRequired: true, isRegExpression:false)
                                                @Html.AccordianBaseDropdown("Assignee", nameof(Model.AssignedTo), Model.lstUsers, isRequired: true, isRegExpression: false)
                                                
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card" style="display: block;">
                                        <div class="card-header card-head" id="headingTwo6">
                                            <div class="card-title collapsed" data-toggle="collapse" data-target="#collapseTwo6" aria-expanded="false">
                                                <i class="icon-sm-sm-2x text-dark-50 flaticon-user-settings"></i>
                                                Personal/Business Information
                                            </div>
                                        </div>
                                        <div id="collapseTwo6" class="collapse" data-parent="#accordionExample6" style="align-self:center">
                                            <div class="card-body">
                                                @Html.AccordianBaseDropdown("Company", nameof(Model.CompanyID), Model.lstCompanies, isRequired: false, isRegExpression: false)
                                                @Html.AccordianBaseDropdown("Lead Status", nameof(Model.LeadStatus), Model.lstLeadStatus, isRequired: false, isRegExpression: false)                                                
                                                @Html.AccordianBaseTextBox("Source Of Lead", nameof(Model.LeadSource), true, "Enter source of lead", 50)                                                
                                                @Html.AccordianBaseDateTimePicker("Next Follow up Date", nameof(Model.NextFollowUpDate), pickerId: "kt_datetimepicker_3")                                                
                                                @Html.AccordianBaseTextArea("Address", nameof(Model.Address), rows: 2, maxLength: 255, placeholder: "Enter address", isRequired: false)
                                                @Html.AccordianBaseTextArea("Notes", nameof(Model.Notes), rows: 2, maxLength: 255, placeholder: "Enter notes", isRequired: false)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <!--end::Card-->
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript">
        var globalvar = {
            IsformView: true,
            tostarMsg: "@TempData["Message"]",
            rowsaffected: "@TempData["RowsAffected"]"
        }
    </script>
    <script src="~/js/pages/lead/_lead.min.js"></script>    
}