@using Insurancesys.web.Helper
@using Insurancesys.web.Models
@using Insurancesys.web.Models.Common
@using Microsoft.AspNetCore.Mvc.Rendering
@model PolicyBasicDetailsViewModel

@{
    var index = ViewBag.Index ?? 0;
    var policyType = ViewBag.PolicyType;
    var prefix = $"{policyType}Policies[{index}].BasicDetails";
    ViewData.TemplateInfo.HtmlFieldPrefix = prefix;
    var companyList = Model.CompanySelectList ?? new List<SelectListItem>();
}


    @Html.HiddenFor(m => m.InsuranceTypeID)
    @Html.HiddenFor(m => m.PolicyId)
    @Html.HiddenFor(m => m.CustomerID)

    <div class="form-group row mt-3">
        @Html.TwoColsHorizontalFormTextBox(
        label: "Policy Number",
        forExpression: "PolicyNumber",
        isRequired: true,
                placeholder: "Enter policy number",
        maxlength: 100)
        @Html.TwoColsHorizontalDropdown(
                label: "Insurer",
        forExpression: "Company",
        companyList,
                isRequired: true)
    </div>

    <div class="form-group row mt-3">
        @Html.TwoColsHorizontalDatePicker(
                label: "Policy Start Date",
        forExpression: "PolicyStartDate",
        placeholder: "Select date",
                isRequired: true)
        @Html.TwoColsHorizontalDatePicker(
                label: "Policy Due Date",
        forExpression: "PolicyDueDate",
        placeholder: "Select date",
                isRequired: true)
    </div>

    <div class="form-group row mt-3">
        @Html.TwoColsHorizontalFormDecimal(
                label: "Gross Premium(with tax)",
        forExpression: "GrosssPremium",
                isRequired: true,
                placeholder: "0.00")
        @Html.TwoColsHorizontalFormDecimal(
                label: "Net Premium",
        forExpression: "NetPremium",
                isRequired: false,
                placeholder: "0.00")
    </div>

    <div class="form-group row mt-3">
        @Html.TwoColsHorizontalFormDecimal(
                label: "OD Premium",
        forExpression: "ODPremium",
                isRequired: false,
                placeholder: "0.00")
        @Html.TwoColsHorizontalFormDecimal(
                label: "No Claim Bonus",
        forExpression: "NCB",
                isRequired: false,
                placeholder: "0.00")
    </div>

    <div class="form-group row mt-3">
        @Html.TwoColsHorizontalFormTextBox(
                label: "Dealer",
        forExpression: "Dealer",
        isRequired: false,
                placeholder: "Enter dealer",
                maxlength: 50)
        @Html.TwoColsHorizontalFormTextBox(
                label: "SM",
        forExpression: "SM",
        isRequired: false,
                placeholder: "Enter SM",
                maxlength: 50)
    </div>
