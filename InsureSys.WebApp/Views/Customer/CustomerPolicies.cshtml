@using System.Text.Json
@using InsuranceSys.Domain.Enums
@using Insurancesys.web.Helper
@using Insurancesys.web.Models.Common
@model Insurancesys.web.Models.PolicyDetailsViewModel
@{
    Layout = "_Layout";
    var gridJson = JsonSerializer.Serialize(
        Model.InsuranceTypesForGrid ?? new List<Insurancesys.web.Models.InsuranceTypePolicyGridItemViewModel>(),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}
@section Styles {
    <link href="~/css/common.css" rel="stylesheet" type="text/css" />
    <link href="~/css/customer/main.css" rel="stylesheet" type="text/css" />    
}

<div class="container-fluid">
    <form id="frmCustomerPolicies" class="form fv-plugins-bootstrap fv-plugins-framework" asp-action="SavePolicies" asp-controller="Customer" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-custom card-sticky" id="kt_page_sticky_card">                    
                    @Html.HiddenFor(x => x.CustomerID)                    
                    <div class="card-header d-flex flex-wrap align-items-center justify-content-between">
                        <div class="card-title mb-0 mr-auto pr-3">
                            <h4 class="mb-1 font-weight-bolder text-dark">Manage policies</h4>
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerDisplayName))
                            {
                                <div class="text-muted font-size-lg font-weight-bold ml-2">
                                    <span> > </span> @Model.CustomerDisplayName
                                </div>
                            }
                        </div>
                        <div class="card-toolbar">
                            <a asp-controller="Customer" asp-action="ListOfCustomers" class="btn btn-danger font-weight-bolder mr-2">
                                <i class="ki ki-long-arrow-back icon-sm"></i>Back
                            </a>
                            <div class="btn-group">                                
                                <button type="submit" id="btnSavePolicies" class="btn btn-primary">
                                    <i class="ki ki-check icon-sm"></i>
                                    Save Policies
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="row justify-content-center align-items-center">
                            <div class="col-md-12">
                                @if (!Model.HasAnyInsuranceTypes)
                                {
                                    <div class="alert alert-custom alert-light-warning policy-empty-alert fade show mb-5" role="alert">
                                        <div class="alert-icon"><i class="flaticon-warning text-warning"></i></div>
                                        <div class="alert-text">
                                            <h5 class="alert-heading font-weight-bolder text-warning mb-1">No Insurance Types Found</h5>
                                            <div class="text-dark-75 font-size-base">Please configure active insurance types in system settings before adding policies.</div>
                                        </div>
                                    </div>
                                }
                                else if (!Model.HasActiveInsuranceTypes)
                                {
                                    <div class="alert alert-custom alert-light-warning policy-empty-alert fade show mb-5" role="alert">
                                        <div class="alert-icon"><i class="flaticon-warning text-warning"></i></div>
                                        <div class="alert-text">
                                            <h5 class="alert-heading font-weight-bolder text-warning mb-1">No Active Insurance Types</h5>
                                            <div class="text-dark-75 font-size-base">All configured insurance types are currently inactive in master settings. Please activate insurance types in system settings to add new policies.</div>
                                        </div>
                                    </div>
                                }

                                @if (Model.HasAnyInsuranceTypes)
                                {
                                    <div class="policy-type-grid">
                                        @foreach (var t in Model.InsuranceTypesForGrid)
                                        {
                                            var cardClass = "policy-card" + (t.IsActive ? "" : " policy-card-disabled");
                                            <div class="@cardClass"
                                                 data-policy-type="@t.Slug"
                                                 data-insurance-type-id="@t.InsuranceTypeId"
                                                 data-is-active="@(t.IsActive.ToString().ToLowerInvariant())"
                                                 data-form-prefix="@t.FormCollectionPrefix"
                                                 data-standard-bucket="@(t.IsStandardBucket.ToString().ToLowerInvariant())">
                                                <div class="policy-icon">@(t.IconEmoji ?? "📋")</div>
                                                <div class="policy-title">@t.DisplayName</div>
                                                <span class="policy-badge inactive">0</span>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (Model.InsuranceTypesForGrid != null)
                                {
                                    foreach (var t in Model.InsuranceTypesForGrid)
                                    {
                                        if (!Enum.TryParse<InsuranceTypeCode>(t.EnumName, out var typeCode))
                                        {
                                            continue;
                                        }

                                        var sectionClass = "policy-section" + (t.IsActive ? "" : " policy-section-disabled");
                                        <div class="@sectionClass"
                                             data-policy-type="@t.Slug"
                                             data-insurance-type-id="@t.InsuranceTypeId"
                                             data-is-active="@(t.IsActive.ToString().ToLowerInvariant())">
                                            <div class="policy-section-header">
                                                <i>@(t.IconEmoji ?? "📋")</i>
                                                <h4>@t.DisplayName</h4>
                                                @if (!t.IsActive)
                                                {
                                                    <span class="badge badge-secondary ml-2">Inactive in master</span>
                                                }
                                            </div>

                                            <div id="@(t.Slug)-policies-container">
                                                @switch (typeCode)
                                                {
                                                    case InsuranceTypeCode.MotorVehicle:
                                                        if (Model.MotorPolicies != null)
                                                        {
                                                            for (int i = 0; i < Model.MotorPolicies.Count; i++)
                                                            {
                                                                ViewBag.Index = i;
                                                                ViewBag.PolicyNumber = i + 1;
                                                                ViewBag.PolicyType = "Motor";
                                                                @Html.Partial("_MotorPolicyPartial", Model.MotorPolicies[i])
                                                            }
                                                        }
                                                        break;
                                                    case InsuranceTypeCode.Health:
                                                        if (Model.HealthPolicies != null)
                                                        {
                                                            for (int i = 0; i < Model.HealthPolicies.Count; i++)
                                                            {
                                                                ViewBag.Index = i;
                                                                ViewBag.PolicyNumber = i + 1;
                                                                ViewBag.PolicyType = "Health";
                                                                @Html.Partial("_HealthPolicyPartial", Model.HealthPolicies[i])
                                                            }
                                                        }
                                                        break;
                                                    case InsuranceTypeCode.Life:
                                                        if (Model.LifePolicies != null)
                                                        {
                                                            for (int i = 0; i < Model.LifePolicies.Count; i++)
                                                            {
                                                                ViewBag.Index = i;
                                                                ViewBag.PolicyNumber = i + 1;
                                                                ViewBag.PolicyType = "Life";
                                                                @Html.Partial("_LifePolicyPartial", Model.LifePolicies[i])
                                                            }
                                                        }
                                                        break;
                                                    case InsuranceTypeCode.PersonalAccident:
                                                        if (Model.PersonalAccidentPolicies != null)
                                                        {
                                                            for (int i = 0; i < Model.PersonalAccidentPolicies.Count; i++)
                                                            {
                                                                ViewBag.Index = i;
                                                                ViewBag.PolicyNumber = i + 1;
                                                                ViewBag.PolicyType = "PersonalAccident";
                                                                @Html.Partial("_PersonalAccidentPolicyPartial", Model.PersonalAccidentPolicies[i])
                                                            }
                                                        }
                                                        break;
                                                    default:
                                                        if (typeCode.UsesStandardPoliciesList() && Model.StandardPolicies != null)
                                                        {
                                                            var ordinal = 1;
                                                            for (int i = 0; i < Model.StandardPolicies.Count; i++)
                                                            {
                                                                var sp = Model.StandardPolicies[i];
                                                                if (sp.BasicDetails?.InsuranceTypeID != t.InsuranceTypeId)
                                                                {
                                                                    continue;
                                                                }
                                                                ViewBag.Index = i;
                                                                ViewBag.PolicyNumber = ordinal++;
                                                                ViewBag.PolicyType = "Standard";
                                                                ViewBag.PolicySlug = t.Slug;
                                                                ViewBag.PolicyDisplayTitle = t.DisplayName;
                                                                @Html.Partial("_StandardPolicyPartial", sp)
                                                            }
                                                        }
                                                        break;
                                                }
                                            </div>

                                            @if (t.IsActive)
                                            {
                                                <button type="button" class="btn-add-another" data-policy-type="@t.Slug" data-insurance-type-id="@t.InsuranceTypeId">
                                                    <span style="font-size: 18px;">+</span>
                                                    Add @t.DisplayName
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script type="application/json" id="policy-type-grid-config">@Html.Raw(gridJson)</script>

@if (TempData["Message"] != null)
{
    <div class="toastr-message" data-message="@TempData["Message"]" data-type="@(TempData["RowsAffected"]?.ToString() == "1" ? "success" : "error")" style="display:none;"></div>
}
@section Scripts {
    <script src="~/assets/js/bootstrap-datetimepicker.js"></script>
    <script src="~/assets/js/pages/features/miscellaneous/sweetalert2.min.js"></script>
    <script src="~/js/pages/customer/customer-policies.js"></script>
}
