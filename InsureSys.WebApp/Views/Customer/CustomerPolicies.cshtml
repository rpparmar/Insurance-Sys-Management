@using Insurancesys.web.Helper
@using Insurancesys.web.Models.Common
@model Insurancesys.web.Models.PolicyDetailsViewModel
@section Styles {
    <link href="~/css/common.css" rel="stylesheet" type="text/css" />
    <link href="~/css/customer/main.css" rel="stylesheet" type="text/css" />    
}
@{
    Layout = "_Layout";   
}

<div class="container-fluid">
    @if (ViewBag.InvalidRequest == true)
    {
        <div class="alert alert-danger" role="alert">
            <div class="alert-icon"><i class="flaticon-warning"></i></div>
            <div class="alert-text">No record found. The link may be invalid or has been tampered with.</div>
        </div>
    }
    @{ var formStyle = ViewBag.InvalidRequest == true ? "display:none;" : ""; }
    <form id="frmCustomerPolicies" class="form fv-plugins-bootstrap fv-plugins-framework" asp-action="SavePolicies" asp-controller="Customer" method="post" enctype="multipart/form-data" style="@formStyle">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-custom card-sticky" id="kt_page_sticky_card">                    
                    @Html.HiddenFor(x => x.CustomerID)
                    <div class="card-header">
                        <div class="card-title"></div>
                        <div class="card-toolbar">
                            <a asp-controller="Customer" asp-action="ListOfCustomers" class="btn btn-danger font-weight-bolder mr-2">
                                <i class="ki ki-long-arrow-back icon-sm"></i>Back
                            </a>
                            <div class="btn-group">                                
                                <button type="submit" id="btnSavePolicies" class="btn btn-primary">
                                    <i class="ki ki-check icon-sm"></i>
                                    Save Policies
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="row justify-content-center align-items-center">
                            <div class="col-md-12">                               
                                <!-- Policy Type Selector -->                                
                                <div class="policy-type-grid">
                                    <div class="policy-card" data-policy-type="motor">
                                        <div class="policy-icon">🚗</div>
                                        <div class="policy-title">Motor Insurance</div>
                                        <span class="policy-badge inactive">0</span>
                                    </div>

                                    <div class="policy-card" data-policy-type="health">
                                        <div class="policy-icon">❤️</div>
                                        <div class="policy-title">Health Insurance</div>
                                        <span class="policy-badge inactive">0</span>
                                    </div>

                                    <div class="policy-card" data-policy-type="life">
                                        <div class="policy-icon">🛡️</div>
                                        <div class="policy-title">Life Insurance</div>
                                        <span class="policy-badge inactive">0</span>
                                    </div>

                                    <div class="policy-card" data-policy-type="personalaccident">
                                        <div class="policy-icon">🚑</div>
                                        <div class="policy-title">Personal Accident</div>
                                        <span class="policy-badge inactive">0</span>
                                    </div>
                                </div>

                                <!-- Motor Policies Section -->
                                <div class="policy-section" data-policy-type="motor">
                                    <div class="policy-section-header">
                                        <i>🚗</i>
                                        <h4>Motor Policies</h4>
                                    </div>

                                    <!-- Container for dynamic motor policies -->
                                    <div id="motor-policies-container">
                                        @if (Model.MotorPolicies != null && Model.MotorPolicies.Count > 0)
                                        {
                                            for (int i = 0; i < Model.MotorPolicies.Count; i++)
                                            {
                                                ViewBag.Index = i;
                                                ViewBag.PolicyNumber = i + 1;
                                                ViewBag.PolicyType = "Motor";
                                                @await Html.PartialAsync("_MotorPolicyPartial", Model.MotorPolicies[i])
                                            }
                                        }
                                    </div>

                                    <button type="button" class="btn-add-another" data-policy-type="motor">
                                        <span style="font-size: 18px;">+</span>
                                        Add Another Motor Policy
                                    </button>
                                </div>

                                <!-- Health Insurance Policies Section -->
                                <div class="policy-section" data-policy-type="health">
                                    <div class="policy-section-header">
                                        <i>❤️</i>
                                        <h4>Health Insurance Policies</h4>
                                    </div>

                                    <!-- Container for dynamic health policies -->
                                    <div id="health-policies-container">
                                        @if (Model.HealthPolicies != null && Model.HealthPolicies.Count > 0)
                                        {
                                            for (int i = 0; i < Model.HealthPolicies.Count; i++)
                                            {
                                                ViewBag.Index = i;
                                                ViewBag.PolicyNumber = i + 1;
                                                ViewBag.PolicyType = "Health";
                                                @await Html.PartialAsync("_HealthPolicyPartial", Model.HealthPolicies[i])
                                            }
                                        }
                                    </div>

                                    <button type="button" class="btn-add-another" data-policy-type="health">
                                        <span style="font-size: 18px;">+</span>
                                        Add Another Health Policy
                                    </button>
                                </div>

                                <!-- Life Policies Section -->
                                <div class="policy-section" data-policy-type="life">
                                    <div class="policy-section-header">
                                        <i>🛡️</i>
                                        <h4>Life Insurance Policies</h4>
                                    </div>

                                    <!-- Container for dynamic life policies -->
                                    <div id="life-policies-container">
                                        @if (Model.LifePolicies != null && Model.LifePolicies.Count > 0)
                                        {
                                            for (int i = 0; i < Model.LifePolicies.Count; i++)
                                            {
                                                ViewBag.Index = i;
                                                ViewBag.PolicyNumber = i + 1;
                                                ViewBag.PolicyType = "Life";
                                                @await Html.PartialAsync("_LifePolicyPartial", Model.LifePolicies[i])
                                            }
                                        }
                                    </div>

                                    <button type="button" class="btn-add-another" data-policy-type="life">
                                        <span style="font-size: 18px;">+</span>
                                        Add Another Life Policy
                                    </button>
                                </div>

                                <!-- Personal Accident Section -->
                                <div class="policy-section" data-policy-type="personalaccident">
                                    <div class="policy-section-header">
                                        <i>🚑</i>
                                        <h4>Personal Accident Policies</h4>
                                    </div>

                                    <!-- Container for dynamic personal accident policies -->
                                    <div id="personalaccident-policies-container">
                                        @if (Model.PersonalAccidentPolicies != null && Model.PersonalAccidentPolicies.Count > 0)
                                        {
                                            for (int i = 0; i < Model.PersonalAccidentPolicies.Count; i++)
                                            {
                                                ViewBag.Index = i;
                                                ViewBag.PolicyNumber = i + 1;
                                                ViewBag.PolicyType = "PersonalAccident";
                                                @await Html.PartialAsync("_PersonalAccidentPolicyPartial", Model.PersonalAccidentPolicies[i])
                                            }
                                        }
                                    </div>

                                    <button type="button" class="btn-add-another" data-policy-type="personalaccident">
                                        <span style="font-size: 18px;">+</span>
                                        Add Another Personal Accident Policy
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
<!-- Hidden message container for toastr -->
@if (TempData["Message"] != null)
{
    <div class="toastr-message" data-message="@TempData["Message"]" data-type="@(TempData["RowsAffected"]?.ToString() == "1" ? "success" : "error")" style="display:none;"></div>
}
@section Scripts {
    <script src="~/assets/js/bootstrap-datetimepicker.js"></script>
    <script src="~/js/pages/customer/customer-policies.js"></script>
}
