@using Insurancesys.web.Helper
@using Insurancesys.web.Models
@model Insurancesys.web.Models.StandardPolicyViewModel

@{
    var index = ViewBag.Index ?? 0;
    var policyNumber = ViewBag.PolicyNumber ?? (index + 1);
    var policySlug = ViewBag.PolicySlug as string ?? "standard";
    var title = ViewBag.PolicyDisplayTitle as string ?? "Policy";

    ViewBag.Index = index;
    ViewBag.PolicyType = "Standard";
}

<div class="policy-instance" data-policy-type="@policySlug" data-policy-index="@index">
    <div class="policy-instance-header">
        <span class="policy-instance-title">@title #@policyNumber</span>
        <button type="button" class="btn-remove" data-policy-type="@policySlug">
            <span>🗑️</span>
            Remove
        </button>
    </div>

    @await Html.PartialAsync("_CommonPolicyDetails", Model.BasicDetails)
    @await Html.PartialAsync("_PolicyPaymentDetails", Model.PolicyPaymentDetails)
</div>
