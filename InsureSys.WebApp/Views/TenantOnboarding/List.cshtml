@model List<InsuranceSys.Application.DTO.TenantInfoDto>
@{
    ViewBag.Title = "All Tenants";
    Layout = "_SuperAdminLayout";
}

<!--begin::Subheader-->
<div class="subheader py-2 py-lg-6 subheader-solid" id="kt_subheader">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h5 class="text-dark font-weight-bold my-1 mr-5">Tenant Management</h5>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <a asp-action="Onboard" class="btn btn-primary font-weight-bolder">
                <i class="fas fa-plus mr-1"></i> Onboard New Tenant
            </a>
        </div>
    </div>
</div>
<!--end::Subheader-->

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card card-custom">
        <div class="card-header">
            <h3 class="card-title">Registered Tenants</h3>
        </div>
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-10">
                    <h4 class="text-muted">No tenants registered yet.</h4>
                    <p>Click "Onboard New Tenant" to add the first agency.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-head-custom table-vertical-center table-head-bg" id="tblTenants">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Tenant Code</th>
                                <th>Agency Name</th>
                                <th>Contact Email</th>
                                <th>Database</th>
                                <th>Server</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var tenant = Model[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><span class="font-weight-bold">@tenant.TenantCode</span></td>
                                    <td>@tenant.AgencyName</td>
                                    <td>@(tenant.ContactEmail ?? "-")</td>
                                    <td><code>@tenant.DatabaseName</code></td>
                                    <td>@tenant.DatabaseServer</td>
                                    <td>
                                        @if (tenant.IsActive)
                                        {
                                            <span class="label label-lg label-light-success label-inline font-weight-bold">Active</span>
                                        }
                                        else
                                        {
                                            <span class="label label-lg label-light-danger label-inline font-weight-bold">Inactive</span>
                                        }
                                    </td>
                                    <td>@tenant.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (tenant.IsActive)
                                        {
                                            <form asp-action="Deactivate" method="post" style="display:inline;"
                                                  onsubmit="return confirm('Are you sure you want to deactivate this tenant?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="tenantId" value="@tenant.TenantId" />
                                                <button type="submit" class="btn btn-sm btn-light-danger font-weight-bold">
                                                    Deactivate
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
