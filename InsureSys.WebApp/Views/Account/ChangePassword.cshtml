@using Insurancesys.web.Helper
@model Insurancesys.web.Models.ChangePasswordViewModel
@section Styles {
    <link href="~/css/common.css" rel="stylesheet" type="text/css" />
}
@{
    Layout = User.IsInRole("SuperAdmin") ? "_SuperAdminLayout" : "_Layout";
    ViewData["Title"] = "Change Password";
    var backController = User.IsInRole("SuperAdmin") ? "AgencyOnboarding" : "Home";
    var backAction = User.IsInRole("SuperAdmin") ? "AgencyList" : "Index";
}

<!--begin::Subheader-->
<div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item">
                        <h5 class="text-dark font-weight-bold my-2 mr-5">@ViewData["Title"]</h5>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!--end::Subheader-->

<div class="container-fluid">
    <form id="frmChangePassword" class="form fv-plugins-bootstrap fv-plugins-framework"
          asp-action="ChangePassword" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-md-12">
                <div class="card card-custom card-sticky" id="kt_page_sticky_card">
                    <div class="card-header">
                        <div class="card-title"></div>
                        <div class="card-toolbar">
                            <a asp-controller="@backController" asp-action="@backAction"
                               class="btn btn-danger font-weight-bolder mr-2">
                                <i class="flaticon2-left-arrow-1 icon-sm-nm"></i>Back
                            </a>
                            <button type="submit" form="frmChangePassword" class="btn btn-primary font-weight-bolder">
                                <i class="ki ki-check icon-sm"></i>Save
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-5"></div>
                        <div class="accordion accordion-solid" id="accordionChangePassword">
                            <div class="card" style="display: block;">
                                <div class="card-header card-head">
                                    <div class="card-title">
                                        <i class="fas fa-lock"></i>
                                        Password
                                    </div>
                                </div>
                                <div class="card-body">
                                    @Html.AccordianBasePasswordBox(
                                        "Current Password",
                                        nameof(Model.OldPassword),
                                        new HtmlHelpers.AccordianPasswordOptions
                                        {
                                            IsRequired = true,
                                            Placeholder = "Enter current password",
                                            AutoComplete = "current-password"
                                        })
                                    @Html.AccordianBasePasswordBox(
                                        "New Password",
                                        nameof(Model.NewPassword),
                                        new HtmlHelpers.AccordianPasswordOptions
                                        {
                                            IsRequired = true,
                                            Placeholder = "Minimum 8 characters",
                                            AutoComplete = "new-password"
                                        })
                                    @Html.AccordianBasePasswordBox(
                                        "Confirm Password",
                                        nameof(Model.ConfirmPassword),
                                        new HtmlHelpers.AccordianPasswordOptions
                                        {
                                            IsRequired = true,
                                            Placeholder = "Re-enter new password",
                                            AutoComplete = "new-password"
                                        })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script type="text/javascript">
        var globalvar = {
            IsformView: true,
            tostarMsg: "@TempData["Message"]",
            rowsaffected: "@TempData["RowsAffected"]"
        };
    </script>
    <script src="~/js/pages/account/_changepassword.js"></script>
}
