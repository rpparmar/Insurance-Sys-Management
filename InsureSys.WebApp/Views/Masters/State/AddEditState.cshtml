@using Insurancesys.web.Helper
@using Insurancesys.web.Models.Common
@model Insurancesys.web.Models.StateViewModel
@section Styles {
    <link href="~/css/common.css" rel="stylesheet" type="text/css" />
}
@{
    Layout = "_Layout";
    if (!Model.IsEditMode)
        ViewData["Title"] = "Add State";
    else
        ViewData["Title"] = "Edit State";
}
<div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item"><a href="" class="text-muted">Masters</a></li>
                    <li class="breadcrumb-item"><h5 class="text-dark font-weight-bold my-2 mr-5">@ViewData["Title"]</h5></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <form id="frmStateMaster" class="form fv-plugins-bootstrap fv-plugins-framework" asp-action="SaveState" asp-controller="State" method="post">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-custom card-sticky" id="kt_page_sticky_card">
                    @Html.HiddenFor(x => x.IsEditMode)
                    @Html.HiddenFor(x => x.StateID)
                    @Html.HiddenFor(x => x.CreatedOn)
                    <div class="card-header">
                        <div class="card-title"></div>
                        <div class="card-toolbar">
                            <a asp-controller="State" asp-action="StateList" class="btn btn-danger font-weight-bolder mr-2">
                                <i class="flaticon2-left-arrow-1 icon-sm-nm"></i>Back
                            </a>
                            @await Html.PartialAsync("_SubmitButtons", new SubmitButtonViewModel
                            {
                                IsEditMode = Model.IsEditMode,
                                FormId = "frmStateMaster"
                            })
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row h-100 justify-content-center align-items-center">
                            <div class="col-md-6">
                                <div class="card-body">                                    
                                    @Html.SimpleFormDropdown("Country", nameof(Model.CountryID), Model.CountrySelectList, true)
                                    @Html.SimpleFormTextBox("State Name", nameof(Model.StateName), true, "Enter state name", 100)
                                    @Html.SimpleFormTextBox("State Code", nameof(Model.StateCode), true, "Enter state code", 5)
                                    @Html.SimpleFormCheckBox("Is Active", nameof(Model.IsActive))
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <script type="text/javascript">
        var globalvar = {
            IsformView: true,
            tostarMsg: "@TempData["Message"]",
            rowsaffected: "@TempData["RowsAffected"]"
        }
    </script>
    <script src="~/js/pages/statemaster/_state.js"></script>
}
