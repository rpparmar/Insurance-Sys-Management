@{
    ViewData["Title"] = "List Of Companies";
    ViewData["paging_size"] = 10; // set by generic way
    Layout = "_Layout";
}
<div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <!--begin::Info-->
        <div class="d-flex align-items-center flex-wrap mr-1">
            <!--begin::Page Heading-->
            <div class="d-flex align-items-baseline mr-5">
                <!--begin::Page Title-->
                <h5 class="text-dark font-weight-bold my-2 mr-5">Manage Company</h5>
                <!--end::Page Title-->
            </div>
            <!--end::Page Heading-->
        </div>
        <!--end::Info-->

    </div>
</div>
<div class="container">
    <div class="card card-custom">
        <div class="card-header flex-wrap border-0 pt-6 pb-0">
            <div class="card-title">
            </div>
            <div class="card-toolbar">
                <label class="text-dark font-weight-bold mr-3 mt-2">Status:</label>
                <div class="btn-group btn-group-toggle" data-toggle="buttons">
                    <label class="btn btn-primary active">
                        <input class="switch_status" type="radio" name="status" data-val="1" autocomplete="off" checked> Active
                    </label>
                    <label class="btn btn-default mr-2">
                        <input class="switch_status" type="radio" name="status" data-val="0" autocomplete="off"> In Active
                    </label>
                </div>
                <!--begin::Button-->
                <a asp-controller="Company" asp-action="AddEditCompany" class="btn btn-primary font-weight-bolder">
                    <i class="fas fa-plus icon-sm"></i>
                    Add Company
                </a>
                <!--end::Button-->
            </div>
        </div>
        <div class="card-body">
            <!--begin::Search Form-->
            <div class="mb-7">
                <div class="row align-items-center">
                    <div class="col-md-12 col-xl-12">
                        <div class="row align-items-center">
                            <div class="col-md-3 my-2 my-md-0">
                                <div class="input-icon">
                                    <input type="text" class="form-control" placeholder="Search..." id="txt_search_query">
                                    <span>
                                        <i class="flaticon2-search-1 text-muted"></i>
                                    </span>
                                </div>
                            </div>
                    </div>
                    </div>
                </div>
            </div>
            <!--end::Search Form-->
            <div id="CompanyList" class="custom-paging">
                @await Html.PartialAsync("_CustomPaging")
            </div>
            <div class="datatable datatable-default datatable-primary datatable-loaded dvDisplay">
                <div id="pagingFooter" class="datatable-pager custom-override">
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_CustomPagingHiddenFields")

@section Scripts {
    <script type="text/javascript">
        var globalvar = {
            divID : "CompanyList",
            actionURL : "@Html.Raw(Url.Action("CompanyListInnerContent", "Company"))",
            IsformView : false,
            tostarMsg : "@TempData["Message"]",
            rowsaffected : "@TempData["RowsAffected"]"
        }
    </script>
    <script src="~/js/Masters/Company/_company.min.js"></script>
    <script src="~/js/_deleteRow.js"></script>
}
