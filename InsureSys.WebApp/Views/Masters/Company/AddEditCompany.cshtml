@using Insurancesys.web.Helper
@model Insurancesys.web.Models.CompanyViewModel
@section Styles {
    <link href="~/css/common.css" rel="stylesheet" type="text/css" />
}
@{
    Layout = "_Layout";
    if (!Model.IsEditMode)
        ViewData["Title"] = "Add Company";
    else
        ViewData["Title"] = "Edit Company";
}
<!--begin::Subheader-->
<div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <!--begin::Info-->
        <div class="d-flex align-items-center flex-wrap mr-1">
            <!--begin::Page Heading-->
            <div class="d-flex align-items-baseline mr-5">
                <!--begin::Breadcrumb-->
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item">
                        <a href="" class="text-muted">Masters</a>
                    </li>
                    <li class="breadcrumb-item">
                        <h5 class="text-dark font-weight-bold my-2 mr-5">@ViewData["Title"]</h5>
                    </li>
                </ul>
                <!--end::Breadcrumb-->
            </div>
            <!--end::Page Heading-->
        </div>
        <!--end::Info-->
    </div>
</div>
<!--end::Subheader-->
<div class="container-fluid">
    <!--begin::Form-->
    <form id="frmCompanyMaster" class="form fv-plugins-bootstrap fv-plugins-framework" asp-action="SaveCompany" asp-controller="Company" method="post">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-custom card-sticky" id="kt_page_sticky_card">
                    @Html.HiddenFor(x => x.IsEditMode)
                    @Html.HiddenFor(x => x.CompanyID)
                    @Html.HiddenFor(x => x.CreatedOn)
                    <div class="card-header">
                        <div class="card-title"></div>
                        <div class="card-toolbar">
                            <a asp-controller="Company" asp-action="CompanyList" class="btn btn-danger font-weight-bolder mr-2">
                                <i class="flaticon2-left-arrow-1 icon-sm-nm"></i>Back
                            </a>
                            @{
                                <button type="submit" form="frmCompanyMaster" name="saveAndExit" value="false" class="btn btn-primary font-weight-bolder mr-2">
                                    <i class="flaticon-interface-5"></i>
                                    <span class="nav-text">@(!Model.IsEditMode ? "Save & Add New" : "Update & continue")</span>
                                </button>
                                <button type="submit" form="frmCompanyMaster" name="saveAndExit" value="true" class="btn btn-warning font-weight-bolder mr-2">
                                    <i class="flaticon-logout"></i>
                                    <span class="nav-text">@(!Model.IsEditMode ? "Save & Exit" : "Update & Exit")</span>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row h-100 justify-content-center align-items-center">
                            <div class="col-md-6">
                                <div class="card-body">
                                    @Html.SimpleFormTextBox("Company Name", nameof(Model.CompanyName), true, "Enter company name", 100)                                   
                                    @Html.SimpleFormCheckBox("Is Active", nameof(Model.IsActive))                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>        
    </form>
    <!--end::Form-->
</div>
@section Scripts {
    <script type="text/javascript">
        var globalvar = {
            IsformView: true,
            tostarMsg: "@TempData["Message"]",
            rowsaffected: "@TempData["RowsAffected"]"
        }
    </script>
    <script src="~/js/pages/companymaster/_company.min.js"></script>
}