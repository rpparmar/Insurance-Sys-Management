@model Insurancesys.web.Models.CompanyViewModel
@{
    Layout = "_Layout";
    if (Model.IsEditMode == false)
        ViewData["Title"] = "Add Company";
    else
        ViewData["Title"] = "Edit Company";
}
<!--begin::Form-->
<form id="frmCompanyMaster" asp-action="SaveCompany" asp-controller="Company" method="post">
    <div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
        <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
            <!--begin::Info-->
            <div class="d-flex align-items-center flex-wrap mr-1">
                <!--begin::Page Heading-->
                <div class="d-flex align-items-baseline mr-5">
                    <!--begin::Page Title-->
                    <h6 class="text-dark font-weight-bold my-2 mr-5">@ViewData["Title"]</h6>
                    <!--end::Page Title-->
                </div>
                <!--end::Page Heading-->
            </div>
            <!--end::Info-->
        </div>
    </div>
    <div class="d-flex flex-column-fluid flex-center">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <!--begin::Card-->
                    <div class="card card-custom gutter-b example-compact">
                        <div class="card card-custom card-sticky" id="kt_page_sticky_card">
                            <div class="card-header" style="">
                                <div class="card-title">
                                    <h3 class="card-label">
                                        <i class="mr-2"></i>
                                        <small class=""></small>
                                    </h3>
                                </div>
                                @Html.HiddenFor(x => x.IsEditMode)
                                @Html.HiddenFor(x => x.CompanyID)
                                <div class="card-toolbar">
                                    <a asp-controller="Company" asp-action="CompanyList" class="btn btn-danger font-weight-bolder mr-2">
                                        <i class="flaticon2-left-arrow-1 icon-sm-nm"></i>Back
                                    </a>
                                    @{
                                        <button type="submit" form="frmCompanyMaster" name="saveAndExit" value="false" class="btn btn-primary font-weight-bolder mr-2">
                                            <i class="flaticon-interface-5"></i>
                                            <span class="nav-text">@(!Model.IsEditMode ? "Save & Add New" : "Update & continue")</span>
                                        </button>
                                        <button type="submit" form="frmCompanyMaster" name="saveAndExit" value="true" class="btn btn-success font-weight-bolder mr-2">
                                            <i class="flaticon-logout"></i>
                                            <span class="nav-text">@(!Model.IsEditMode ? "Save & Exit" : "Update & Exit")</span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="row h-100 justify-content-center align-items-center">
                                <div class="col-md-6">
                                    <div class="card-body">
                                        <div class="form-group row">
                                            <div class="col-4 text-right">
                                                <label class="col-form-label">
                                                    Company Name:
                                                    <span class="text-danger">*</span>
                                                </label>
                                            </div>
                                            <div class="col-8">
                                                <input class="form-control" type="text" asp-for="CompanyName" id="txtCompanyName" autocomplete="off" autofocus />
                                                <span asp-validation-for="CompanyName" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-4 text-right">
                                                <label class="col-form-label">Is Active: </label>
                                            </div>
                                            <div class="col-8">
                                                <span class='switch switch-icon'>
                                                    <label>
                                                        <input type='checkbox' id="chkIsActive" asp-for="IsActive">
                                                        <span></span>
                                                    </label>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--end::Card-->
                </div>
            </div>
        </div>
    </div>
</form>
<!--end::Form-->
@section Scripts {
    <script type="text/javascript">
        var globalvar = {
            IsformView: true,
            tostarMsg: "@TempData["Message"]",
            rowsaffected: "@TempData["RowsAffected"]"
        }
    </script>
    <script src="~/js/Masters/Company/_company.js"></script>
}