@using Insurancesys.web.Helper
@using Insurancesys.web.Models.Common
@model Insurancesys.web.Models.InsuranceTypeViewModel
@section Styles {
    <link href="~/css/common.css" rel="stylesheet" type="text/css" />
}
@{
    Layout = "_Layout";
    if (!Model.IsEditMode)
        ViewData["Title"] = "Add Insurance Type";
    else
        ViewData["Title"] = "Edit Insurance Type";
}
<!--begin::Subheader-->
<div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <!--begin::Info-->
        <div class="d-flex align-items-center flex-wrap mr-1">
            <!--begin::Page Heading-->
            <div class="d-flex align-items-baseline mr-5">
                <!--begin::Breadcrumb-->
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item">
                        <a href="" class="text-muted">Masters</a>
                    </li>
                    <li class="breadcrumb-item">
                        <h5 class="text-dark font-weight-bold my-2 mr-5">@ViewData["Title"]</h5>
                    </li>
                </ul>
                <!--end::Breadcrumb-->
            </div>
            <!--end::Page Heading-->
        </div>
        <!--end::Info-->
    </div>
</div>
<!--end::Subheader-->
<div class="container-fluid">
    <!--begin::Form-->
    <form id="frmInsuranceTypeMaster" class="form fv-plugins-bootstrap fv-plugins-framework" asp-action="SaveInsuranceType" asp-controller="InsuranceType" method="post">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-custom card-sticky" id="kt_page_sticky_card">
                    @Html.HiddenFor(x => x.IsEditMode)
                    @Html.HiddenFor(x => x.InsuranceTypeId)
                    @Html.HiddenFor(x => x.CreatedOn)
                    <div class="card-header">
                        <div class="card-title"></div>
                        <div class="card-toolbar">
                            <a asp-controller="InsuranceType" asp-action="InsuranceTypeList" class="btn btn-danger font-weight-bolder mr-2">
                                <i class="flaticon2-left-arrow-1 icon-sm-nm"></i>Back
                            </a>
                            @await Html.PartialAsync("_SubmitButtons", new SubmitButtonViewModel
                            {
                                IsEditMode = Model.IsEditMode,
                                FormId = "frmInsuranceTypeMaster"
                            })                            
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row h-100 justify-content-center align-items-center">
                            <div class="col-md-6">
                                <div class="card-body">
                                    @Html.SimpleFormTextBox("Type Of Insurance", nameof(Model.InsuranceType), true, "Enter type", 100)
                                    @Html.SimpleFormDropdown("Insurance Template", nameof(Model.InsuranceTypeCode), Model.FormTemplateSelectList, true, "Select form layout")
                                    @Html.SimpleFormDropdown("Icon to display", nameof(Model.IconClass), Model.IconSelectList, false, "Select icon")
                                    <div class="form-group row">
                                        <div class="col-md-4 col-xs-12 text-md-right">
                                            <label class="col-form-label">Preview</label>
                                        </div>
                                        <div class="col-md-8 col-xs-12 d-flex align-items-center">
                                            <span class="insurance-type-icon-preview text-primary" style="font-size: 28px;">
                                                <i class="@(string.IsNullOrWhiteSpace(Model.IconClass) ? "fas fa-file-alt" : Model.IconClass)"></i>
                                            </span>
                                        </div>
                                    </div>
                                    @Html.SimpleFormMuliSelectDropdown("Choose Associated Companies", "drpCompanies", Model.lstOfCompanies, "SetIDs()")
                                    @Html.SimpleFormCheckBox("Is Active", nameof(Model.IsActive))
                                    @Html.HiddenFor(i => i.AssociationWithCompanyIDs)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>        
    </form>
    <!--end::Form-->
</div>
@section Scripts {
    <script src="~/assets/js/pages/crud/forms/widgets/select2.min.js"></script>
    <script type="text/javascript">
        var globalvar = {
            IsformView: true,
            tostarMsg: "@TempData["Message"]",
            rowsaffected: "@TempData["RowsAffected"]"
        }
    </script>
    <script src="~/js/pages/insurancetypemaster/_insurancetype.js"></script>
}