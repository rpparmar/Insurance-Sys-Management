<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @await Html.PartialAsync("_LayoutHeadScriptsPartial")
    <style>
        .navi.navi-spacer-x-0 .navi-item .navi-link {
            padding-bottom: 0;
        }

        @@media print {
            .noprint {
                visibility: hidden;
            }
