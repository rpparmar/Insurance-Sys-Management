@model Insurancesys.web.Models.AgencyOnboardingViewModel
@section Styles {
    <link href="~/css/common.css" rel="stylesheet" type="text/css" />
}
@{
    ViewBag.Title = "Add Agency";
    Layout = "_SuperAdminLayout";
}

<!--begin::Subheader-->
<div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("List", "AgencyOnboarding")" class="text-muted">Agency Management</a>
                    </li>
                    <li class="breadcrumb-item">
                        <h5 class="text-dark font-weight-bold my-2 mr-5">@ViewBag.Title</h5>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!--end::Subheader-->

<div class="container-fluid">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <form asp-action="AddEditAgency" asp-controller="AgencyOnboarding" method="post" id="frmAgency" class="form fv-plugins-bootstrap fv-plugins-framework">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-md-12">
                <div class="card card-custom card-sticky" id="kt_page_sticky_card">
                    <div class="card-header">
                        <div class="card-title">
                            <h3 class="card-label">New Agency / Agent Registration</h3>
                        </div>
                        <div class="card-toolbar">
                            <a asp-controller="AgencyOnboarding" asp-action="List" class="btn btn-danger font-weight-bolder mr-2">
                                <i class="ki ki-long-arrow-back icon-sm"></i>Back
                            </a>
                            <button type="submit" class="btn btn-primary font-weight-bolder">
                                <i class="ki ki-check icon-sm"></i>Create Agency
                            </button>
                        </div>
                    </div>

                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-5"></div>

                        <h4 class="font-weight-bold text-dark mb-4">Agency details</h4>
                        <div class="form-group row">
                            @Html.LabelFor(m => m.AgencyName, new { @class = "col-lg-2 col-form-label text-right required" })
                            <div class="col-lg-3">
                                @Html.TextBoxFor(m => m.AgencyName, new { @class = "form-control", placeholder = "Agency or agent full name", autocomplete = "organization" })
                                @Html.ValidationMessageFor(m => m.AgencyName, "", new { @class = "text-danger" })
                            </div>
                            @Html.LabelFor(m => m.AgencyCode, new { @class = "col-lg-2 col-form-label text-right" })
                            <div class="col-lg-3">
                                @Html.TextBoxFor(m => m.AgencyCode, new { @class = "form-control", placeholder = "Optional short code", autocomplete = "off" })
                                @Html.ValidationMessageFor(m => m.AgencyCode, "", new { @class = "text-danger" })
                                <span class="form-text text-muted">Letters, numbers, and underscores only. Leave blank if not needed.</span>
                            </div>
                        </div>
                        <div class="form-group row">
                            @Html.LabelFor(m => m.ContactEmail, new { @class = "col-lg-2 col-form-label text-right" })
                            <div class="col-lg-3">
                                @Html.TextBoxFor(m => m.ContactEmail, new { @class = "form-control", placeholder = "email@example.com", type = "email" })
                                @Html.ValidationMessageFor(m => m.ContactEmail, "", new { @class = "text-danger" })
                            </div>
                            @Html.LabelFor(m => m.ContactPhone, new { @class = "col-lg-2 col-form-label text-right" })
                            <div class="col-lg-3">
                                @Html.TextBoxFor(m => m.ContactPhone, new { @class = "form-control", placeholder = "Phone number", autocomplete = "tel" })
                                @Html.ValidationMessageFor(m => m.ContactPhone, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <p class="form-text text-muted mb-0 ml-lg-2">A dedicated database name is created automatically when you save (format: Insuresys_[admin username]_[timestamp]).</p>

                        <div class="separator separator-dashed my-8"></div>

                        <h4 class="font-weight-bold text-dark mb-4">Admin credentials</h4>
                        <div class="form-group row align-items-center">
                            @Html.LabelFor(m => m.AdminUsername, new { @class = "col-lg-2 col-form-label text-right required" })
                            <div class="col-lg-3 d-flex align-items-center flex-wrap">
                                @Html.TextBoxFor(m => m.AdminUsername, new { @class = "form-control", placeholder = "Login username for this agency", autocomplete = "username" })
                                <span class="ml-2" data-toggle="tooltip" data-placement="right" title="Use 1 to 100 characters: letters, numbers, underscore, and at-sign only. No spaces. Used for agency login.">
                                    <i class="fas fa-info-circle text-muted" aria-hidden="true"></i>
                                </span>
                                @Html.ValidationMessageFor(m => m.AdminUsername, "", new { @class = "text-danger w-100" })
                            </div>
                            <div class="col-lg-5"></div>
                        </div>
                        <div class="form-group row">
                            @Html.LabelFor(m => m.AdminPassword, new { @class = "col-lg-2 col-form-label text-right required" })
                            <div class="col-lg-3">
                                @Html.PasswordFor(m => m.AdminPassword, new { @class = "form-control", placeholder = "Minimum 8 characters", autocomplete = "new-password" })
                                @Html.ValidationMessageFor(m => m.AdminPassword, "", new { @class = "text-danger" })
                            </div>
                            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-lg-2 col-form-label text-right required" })
                            <div class="col-lg-3">
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Re-enter password", autocomplete = "new-password" })
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            if (typeof $ !== 'undefined' && $.fn.tooltip) {
                $('[data-toggle="tooltip"]').tooltip();
            }
        })();
    </script>
}
