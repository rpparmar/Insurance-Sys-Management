@using Insurancesys.web.Helper
@model Insurancesys.web.Models.AgencyOnboardingViewModel
@section Styles {
    <link href="~/css/common.css" rel="stylesheet" type="text/css" />
}
@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = Model.IsEditMode ? "Edit Agency" : "Add Agency";
}

<!--begin::Subheader-->
<div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("AgencyList", "AgencyOnboarding")" class="text-muted">Agency Management</a>
                    </li>
                    <li class="breadcrumb-item">
                        <h5 class="text-dark font-weight-bold my-2 mr-5">@ViewData["Title"]</h5>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!--end::Subheader-->

<div class="container-fluid">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <form id="frmAgency" class="form fv-plugins-bootstrap fv-plugins-framework" asp-action="SaveAgency" asp-controller="AgencyOnboarding" method="post">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.AgencyId)
        @Html.HiddenFor(m => m.IsEditMode)
        @Html.HiddenFor(m => m.IsAdminUsernameEditEnabled, new { id = "hdnIsAdminUsernameEditEnabled" })
        <div class="row">
            <div class="col-md-12">
                <div class="card card-custom card-sticky" id="kt_page_sticky_card">
                    <div class="card-header">
                        <div class="card-title"></div>
                        <div class="card-toolbar">
                            <a asp-controller="AgencyOnboarding" asp-action="AgencyList" class="btn btn-danger font-weight-bolder mr-2">
                                <i class="ki ki-long-arrow-back icon-sm"></i>Back
                            </a>
                            <button type="submit" form="frmAgency" class="btn btn-primary font-weight-bolder">
                                <i class="ki ki-check icon-sm"></i>@(Model.IsEditMode ? "Save" : "Create Agency")
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-5"></div>
                        <div class="row justify-content-center align-items-center">
                            <div class="col-md-12">
                                <div class="accordion accordion-solid" id="accordionAgencyDetails">
                                    <div class="card" style="display: block;">
                                        <div class="card-header card-head">
                                            <div class="card-title">
                                                <i class="far fa-building"></i>
                                                Agency &amp; contact
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            @Html.AccordianBaseTextBox("Agency/Agent Name", nameof(Model.AgencyName), true, "Agency or agent full name", 200)
                                            @Html.AccordianBaseTextBox("Agency Code", nameof(Model.AgencyCode), false, "Optional short code", 50, isRegExpression: true)
                                            @* <p class="form-text text-muted col-12 offset-md-5 pl-md-0 mb-3">Letters, numbers, and underscores only. Leave blank if not needed.</p> *@
                                            @Html.AccordianBaseTextBox("First Name", nameof(Model.FirstName), true, "First name", 25)
                                            @Html.AccordianBaseTextBox("Middle Name", nameof(Model.MiddleName), false, "Middle name", 25)
                                            @Html.AccordianBaseTextBox("Last Name", nameof(Model.LastName), true, "Last name", 25)

                                            @Html.AccordianBaseTextBox("Contact Email", nameof(Model.ContactEmail), false, "email@example.com", 256, isRegExpression: true)
                                            @Html.AccordianBasePhoneNumberWithCode("Contact Phone", nameof(Model.ContactPhone), isRequired: false, placeholder: "Enter 10-digit phone number")

                                            @Html.AccordianBaseFormCheckBox("Active", nameof(Model.IsActive))

                                            @Html.AccordianBaseTextBoxWithTooltip(
                                                     label: "Username",
                                                     forExpression: nameof(Model.AdminUsername),
                                                     tooltip: "Use 1 to 100 characters: letters, numbers, underscore, and at-sign only. No spaces. Used for agency login.",
                                                     options: new Insurancesys.web.Helper.HtmlHelpers.AccordianTextBoxWithTooltipOptions
                                                     {
                                                         IsRequired = !Model.IsEditMode,
                                                         Placeholder = "Login username for this agency",
                                                         MaxLength = 100,
                                                         IsRegExpression = true,
                                                         IsReadOnly = Model.IsEditMode,
                                                         ShowEditButton = Model.IsEditMode && User.IsInRole("SuperAdmin"),
                                                         EditButtonId = "btnEnableAdminUsernameEdit",
                                                         EditButtonTitle = "Edit username",
                                                         EditButtonCssClass = "btn btn-sm btn-clean btn-icon ml-2",
                                                         EditButtonIconCssClass = "flaticon-edit text-primary"
                                                     }
                                                     )

                                            @if (!Model.IsEditMode)
                                            {
                                                @Html.AccordianBasePasswordBox("Password", nameof(Model.AdminPassword), new Insurancesys.web.Helper.HtmlHelpers.AccordianPasswordOptions { IsRequired = true, Placeholder = "Minimum 8 characters", AutoComplete = "new-password" })
                                                @Html.AccordianBasePasswordBox("Confirm Password", nameof(Model.ConfirmPassword), new Insurancesys.web.Helper.HtmlHelpers.AccordianPasswordOptions { IsRequired = true, Placeholder = "Re-enter password", AutoComplete = "new-password" })
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script type="text/javascript">
        var globalvar = { IsformView: true };
    </script>
    <script src="~/js/pages/agencymaster/_agency.js"></script>
}
