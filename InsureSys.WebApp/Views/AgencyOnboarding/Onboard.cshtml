@model Insurancesys.web.Models.AgencyOnboardingViewModel
@{
    ViewBag.Title = "Onboard New Agency";
    Layout = "_SuperAdminLayout";
}

<!--begin::Subheader-->
<div class="subheader py-2 py-lg-6 subheader-solid" id="kt_subheader">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h5 class="text-dark font-weight-bold my-1 mr-5">Onboard New Tenant</h5>
            </div>
        </div>
    </div>
</div>
<!--end::Subheader-->

<div class="container-fluid">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card card-custom">
        <div class="card-header">
            <h3 class="card-title">New Agency / Agent Registration</h3>
        </div>
        <form asp-action="Onboard" method="post" id="frmOnboard">
            @Html.AntiForgeryToken()
            <div class="card-body">
                <!--begin::Agency Details-->
                <h4 class="font-weight-bold text-dark mb-4">Agency Details</h4>
                <div class="form-group row">
                    <div class="col-lg-6">
                        <label asp-for="AgencyCode" class="font-weight-bold"></label>
                        <input asp-for="AgencyCode" class="form-control form-control-solid" placeholder="e.g. ACME_INS" />
                        <span asp-validation-for="AgencyCode" class="text-danger"></span>
                        <span class="form-text text-muted">Unique short code (letters, numbers, underscore only)</span>
                    </div>
                    <div class="col-lg-6">
                        <label asp-for="AgencyName" class="font-weight-bold"></label>
                        <input asp-for="AgencyName" class="form-control form-control-solid" placeholder="Agency/Agent full name" />
                        <span asp-validation-for="AgencyName" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-lg-6">
                        <label asp-for="ContactEmail" class="font-weight-bold"></label>
                        <input asp-for="ContactEmail" class="form-control form-control-solid" placeholder="email@example.com" />
                        <span asp-validation-for="ContactEmail" class="text-danger"></span>
                    </div>
                    <div class="col-lg-6">
                        <label asp-for="ContactPhone" class="font-weight-bold"></label>
                        <input asp-for="ContactPhone" class="form-control form-control-solid" placeholder="Phone number" />
                        <span asp-validation-for="ContactPhone" class="text-danger"></span>
                    </div>
                </div>
                <!--end::Agency Details-->

                <div class="separator separator-dashed my-8"></div>

                <!--begin::Database Configuration-->
                <h4 class="font-weight-bold text-dark mb-4">Database Configuration</h4>
                <div class="form-group row">
                    <div class="col-lg-6">
                        <label asp-for="DesiredDatabaseName" class="font-weight-bold"></label>
                        <input asp-for="DesiredDatabaseName" class="form-control form-control-solid" placeholder="e.g. InsureSys_ACME" />
                        <span asp-validation-for="DesiredDatabaseName" class="text-danger"></span>
                        <span class="form-text text-muted">Dedicated database will be created with this name</span>
                    </div>
                </div>
                <!--end::Database Configuration-->

                <div class="separator separator-dashed my-8"></div>

                <!--begin::Admin Credentials-->
                <h4 class="font-weight-bold text-dark mb-4">Admin Credentials</h4>
                <div class="form-group row">
                    <div class="col-lg-6">
                        <label asp-for="AdminUsername" class="font-weight-bold"></label>
                        <input asp-for="AdminUsername" class="form-control form-control-solid" placeholder="Admin username for this tenant" />
                        <span asp-validation-for="AdminUsername" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-lg-6">
                        <label asp-for="AdminPassword" class="font-weight-bold"></label>
                        <input asp-for="AdminPassword" class="form-control form-control-solid" placeholder="Minimum 8 characters" />
                        <span asp-validation-for="AdminPassword" class="text-danger"></span>
                    </div>
                    <div class="col-lg-6">
                        <label asp-for="ConfirmPassword" class="font-weight-bold"></label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-solid" placeholder="Re-enter password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
                <!--end::Admin Credentials-->

                <div class="separator separator-dashed my-8"></div>

                <!--begin::Notes-->
                <div class="form-group row">
                    <div class="col-lg-12">
                        <label asp-for="Notes" class="font-weight-bold"></label>
                        <textarea asp-for="Notes" class="form-control form-control-solid" rows="3" placeholder="Optional notes about this tenant"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </div>
                <!--end::Notes-->
            </div>
            <div class="card-footer">
                <div class="row">
                    <div class="col-lg-6">
                        <button type="submit" class="btn btn-primary mr-2">
                            <i class="fas fa-check mr-1"></i> Onboard Tenant
                        </button>
                        <a asp-action="List" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
