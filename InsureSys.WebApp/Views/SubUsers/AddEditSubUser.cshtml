@using Insurancesys.web.Helper
@using Insurancesys.web.Models.Common
@using Microsoft.AspNetCore.Mvc.Rendering
@model Insurancesys.web.Models.SubUserViewModel
@section Styles {
    <link href="~/css/common.css" rel="stylesheet" type="text/css" />
}
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.IsEditMode ? "Edit user" : "Add user";
    var roleSelectList = ViewBag.RoleSelectList as List<SelectListItem> ?? new List<SelectListItem>();
}

<!--begin::Subheader-->
<div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item">
                        <a asp-controller="SubUsers" asp-action="SubUsersList" class="text-muted">Manage users</a>
                    </li>
                    <li class="breadcrumb-item">
                        <h5 class="text-dark font-weight-bold my-2 mr-5">@ViewData["Title"]</h5>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!--end::Subheader-->

<div class="container-fluid">
    <form id="frmSubUser" class="form fv-plugins-bootstrap fv-plugins-framework" asp-action="SaveSubUser" asp-controller="SubUsers" method="post">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IsEditMode)
        @Html.HiddenFor(m => m.UserId)
        <div class="row">
            <div class="col-md-12">
                <div class="card card-custom card-sticky" id="kt_page_sticky_card">
                    <div class="card-header">
                        <div class="card-title"></div>
                        <div class="card-toolbar">
                            <a asp-controller="SubUsers" asp-action="SubUsersList" class="btn btn-danger font-weight-bolder mr-2">
                                <i class="flaticon2-left-arrow-1 icon-sm-nm"></i>Back
                            </a>
                            @await Html.PartialAsync("_SubmitButtons", new SubmitButtonViewModel
                            {
                                IsEditMode = Model.IsEditMode,
                                FormId = "frmSubUser"
                            })
                        </div>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-5"></div>
                        <div class="accordion accordion-solid" id="accordionSubUser">
                            <div class="card" style="display: block;">
                                <div class="card-header card-head">
                                    <div class="card-title">
                                        <i class="fas fa-user"></i>
                                        User details
                                    </div>
                                </div>
                                <div class="card-body">
                                    @*@Html.AccordianBaseTextBox("Username", nameof(Model.UserName), true, "Login username", 100, isRegExpression: true)*@
                                    @Html.AccordianBaseTextBoxWithTooltip(
                                                                        label: "Username",
                                                                        forExpression: nameof(Model.UserName),
                                                                        tooltip: "Use 1 to 100 characters: letters, numbers, underscore, and at-sign only. No spaces allowed.",
                                                                        options: new Insurancesys.web.Helper.HtmlHelpers.AccordianTextBoxWithTooltipOptions
                                                                        {
                                                                            IsRequired = true,
                                                                            Placeholder = "Username",
                                                                            MaxLength = 100,
                                                                            IsRegExpression = true                                                                            
                                                                        }
                                                                        )
                                    @Html.AccordianBaseDropdown("Role", nameof(Model.Role), roleSelectList, true)
                                    @Html.AccordianBaseTextBox("First Name", nameof(Model.FirstName), true, "First name", 25, isRegExpression: true)
                                    @Html.AccordianBaseTextBox("Middle Name", nameof(Model.MiddleName), false, "Middle name", 25)
                                    @Html.AccordianBaseTextBox("Last Name", nameof(Model.LastName), true, "Last name", 25, isRegExpression: true)
                                    @Html.AccordianBaseTextBox("Email", nameof(Model.Email), false, "email@example.com", 256, isRegExpression: true)
                                    
                                    @if (!Model.IsEditMode)
                                    {
                                        @Html.AccordianBasePasswordBox("Password", nameof(Model.Password), new Insurancesys.web.Helper.HtmlHelpers.AccordianPasswordOptions { IsRequired = true, Placeholder = "Minimum 8 characters", AutoComplete = "new-password" })
                                        @Html.AccordianBasePasswordBox("Confirm Password", nameof(Model.ConfirmPassword), new Insurancesys.web.Helper.HtmlHelpers.AccordianPasswordOptions { IsRequired = true, Placeholder = "Re-enter password", AutoComplete = "new-password" })
                                    }
                                    else
                                    {
                                        @Html.AccordianBasePasswordBox("Password", nameof(Model.Password), new Insurancesys.web.Helper.HtmlHelpers.AccordianPasswordOptions { IsRequired = false, Placeholder = "Leave blank to keep existing", AutoComplete = "new-password" })
                                        @Html.AccordianBasePasswordBox("Confirm Password", nameof(Model.ConfirmPassword), new Insurancesys.web.Helper.HtmlHelpers.AccordianPasswordOptions { IsRequired = false, Placeholder = "Re-enter new password", AutoComplete = "new-password" })
                                    }
                                    @Html.AccordianBaseFormCheckBox("Active", nameof(Model.IsActive))

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script type="text/javascript">
        var globalvar = {
            IsformView: true,
            tostarMsg: "@TempData["Message"]",
            rowsaffected: "@TempData["RowsAffected"]"
        }
    </script>
    <script src="~/js/pages/subusersmaster/_subusers.js"></script>
}

