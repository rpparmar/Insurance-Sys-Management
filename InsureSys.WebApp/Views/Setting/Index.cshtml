@using Insurancesys.web.Helper
@model Insurancesys.web.Models.SettingsViewModel
@{
    Layout = User.IsInRole("SuperAdmin") ? "_SuperAdminLayout" : "_Layout";
    ViewData["Title"] = "Settings";
    var emailPrefix = nameof(Model.EmailSettings);
}
@section Styles {
    <link href="~/css/common.css" rel="stylesheet" type="text/css" />
    <link href="~/css/pages/setting.css" rel="stylesheet" type="text/css" />
}

<!--begin::Subheader-->
<div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline mr-5">
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item">
                        <h5 class="text-dark font-weight-bold my-2 mr-5">@ViewData["Title"]</h5>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!--end::Subheader-->

<div class="container-fluid" id="settingsPage">
    <form id="frmSettings" class="form fv-plugins-bootstrap fv-plugins-framework">
        @Html.AntiForgeryToken()
        <div class="card settings-shell">
            <div class="row sticky-search-row">
                <div class="col-md-12">
                    <div class="card card-custom card-sticky" id="kt_page_sticky_card">
                        <div class="card-header">
                            <div class="card-title">
                                <div class="input-icon">
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Search..."
                                           id="txtSearchContent"
                                           autocomplete="off"
                                           aria-label="Search settings" />
                                    <span>
                                        <i class="flaticon2-search-1 text-muted"></i>
                                    </span>
                                </div>
                            </div>
                            <div class="card-toolbar">
                                <button type="button" id="btnSaveSettings" class="btn btn-primary font-weight-bolder">
                                    <i class="ki ki-check icon-sm"></i>Save Settings
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row settings-body" data-sticky-container="">
                <div class="col-lg-3 col-xl-2 setting-left-col">
                    <div class="setting-left-nav">
                        <div class="card-body p-0">
                            <ul class="navi navi-bold navi-hover my-5" role="tablist">
                                <li class="navi-item">
                                    <a class="navi-link leftpan-anchor js-setting-nav active" href="#emailSettings">
                                        <span class="navi-icon">
                                            <i class="fas fa-envelope"></i>
                                        </span>
                                        <span class="navi-text">Email Features</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-lg-9 col-xl-10">
                    <div id="settingsSearchEmpty" class="alert alert-light-warning d-none mb-5" role="status">
                        No matching settings.
                    </div>
                    <div id="emailSettings"
                         class="accordion-inner-content js-setting-section"
                         data-section-id="emailSettings">
                        <div class="js-setting-division">
                            <div class="row">
                                <div class="col-md-12">
                                    <p class="setting-division-title text-center font-weight-bold font-size-h5 px-8 py-3 mr-2 mb-0">Email Settings</p>
                                    <div class="separator separator-solid separator-border-2 separator-success mb-2"></div>
                                </div>
                            </div>
                            <div class="js-setting-item" data-search-terms="smtp host server mail">
                                @Html.AccordianBaseTextBox(
                                    "SMTP Server",
                                    $"{emailPrefix}.{nameof(Model.EmailSettings.SmtpHost)}",
                                    false,
                                    "smtp.example.com",
                                    255)
                            </div>
                            <div class="js-setting-item" data-search-terms="smtp port">
                                @Html.AccordianBaseNumberBox(
                                    "SMTP Server Port",
                                    $"{emailPrefix}.{nameof(Model.EmailSettings.SmtpPort)}",
                                    new HtmlHelpers.AccordianNumberOptions
                                    {
                                        Placeholder = "587",
                                        Min = 1,
                                        Max = 65535
                                    })
                            </div>
                            <div class="js-setting-item" data-search-terms="username user name credentials">
                                @Html.AccordianBaseTextBox(
                                    "User Name",
                                    $"{emailPrefix}.{nameof(Model.EmailSettings.UserName)}",
                                    false,
                                    "SMTP user name",
                                    256)
                            </div>
                            <div class="js-setting-item" data-search-terms="password app password credentials">
                                @Html.AccordianBasePasswordBox(
                                    "App Password",
                                    $"{emailPrefix}.{nameof(Model.EmailSettings.Password)}",
                                    new HtmlHelpers.AccordianPasswordOptions
                                    {
                                        Placeholder = "Enter password",
                                        AutoComplete = "new-password"
                                    })
                            </div>
                            <div class="js-setting-item" data-search-terms="timeout connection seconds">
                                @Html.AccordianBaseNumberBox(
                                    "Connection Timeout (in seconds)",
                                    $"{emailPrefix}.{nameof(Model.EmailSettings.ConnectionTimeoutSeconds)}",
                                    new HtmlHelpers.AccordianNumberOptions
                                    {
                                        Placeholder = "30",
                                        Min = 1,
                                        Max = 300
                                    })
                            </div>
                            <div class="js-setting-item" data-search-terms="domain">
                                @Html.AccordianBaseTextBox(
                                    "Domain",
                                    $"{emailPrefix}.{nameof(Model.EmailSettings.Domain)}",
                                    false,
                                    "Optional SMTP domain",
                                    255)
                            </div>
                            <div class="js-setting-item" data-search-terms="ssl tls encryption secure">
                                @Html.AccordianBaseFormCheckBox(
                                    "Use SSL",
                                    $"{emailPrefix}.{nameof(Model.EmailSettings.UseSsl)}",
                                    "chkUseSsl")
                            </div>
                            <div class="js-setting-item" data-search-terms="send as sender from address">
                                @Html.AccordianBaseTextBox(
                                    "Send As Address",
                                    $"{emailPrefix}.{nameof(Model.EmailSettings.SendAsAddress)}",
                                    false,
                                    "noreply@example.com",
                                    256,
                                    true)
                            </div>
                            <div class="js-setting-item" data-search-terms="reporting email address">
                                @Html.AccordianBaseTextArea(
                                    "Reporting Email Address",
                                    $"{emailPrefix}.{nameof(Model.EmailSettings.ReportingEmailAddress)}",
                                    2,
                                    500,
                                    "Optional reporting recipients")
                            </div>
                        </div>

                        <div class="js-setting-division" id="testEmail">
                            <div class="row">
                                <div class="col-md-12">
                                    <p class="setting-division-title text-center font-weight-bold font-size-h5 px-8 py-3 mr-2 mb-0">Test Email Configuration</p>
                                    <div class="separator separator-solid separator-border-2 separator-success mb-2"></div>
                                </div>
                            </div>
                            <div class="js-setting-item" data-search-terms="to recipient test email address">
                                @Html.AccordianBaseTextBox(
                                    "To Email Address",
                                    nameof(Model.TestRecipientEmail),
                                    false,
                                    "recipient@example.com",
                                    256,
                                    true)
                            </div>
                            <div class="form-group row js-setting-item" data-search-terms="send test email">
                                <div class="col-md-5 col-xs-12"></div>
                                <div class="col-md-4 col-xs-12">
                                    <button type="button" id="btnSendTestEmail" class="btn btn-success font-weight-bolder">
                                        <i class="fas fa-paper-plane icon-sm"></i>
                                        Send Test Email
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/pages/setting/_setting.js"></script>
}
